{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    // ⚠️ 只做类型检查，**不要**在旁边生成 vite.config.js：
    //    Vite 解析配置时 .js 优先于 .ts，那份陈旧副本会把 vite.config.ts 的改动整个吃掉
    //    （曾因此误以为「分包策略没生效」）。
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.tmp/tsconfig-node"
  },
  "include": ["vite.config.ts"]
}
