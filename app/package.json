{
  "name": "mensic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "mensic — 本地数据可视化编辑器（Tauri + React + Plotly）",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/ensure-cases.mjs",
    "build": "tsc -b && vite build",
    "prebuild": "node scripts/ensure-cases.mjs --keep-mode",
    "preview": "vite preview",
    "setup:python": "node scripts/setup-python.mjs",
    "setup:assets": "node scripts/setup-assets.mjs",
    "check:assets": "node scripts/setup-assets.mjs --check",
    "sync:catalog": "node scripts/sync-catalog.mjs && node scripts/gen-thumbnails.mjs --strict",
    "sync:catalog:release": "node scripts/sync-catalog.mjs --release && node scripts/gen-thumbnails.mjs --missing --strict",
    "dist": "node scripts/sync-catalog.mjs --release && node scripts/gen-thumbnails.mjs --missing --strict && tauri build && node scripts/collect-release.mjs win",
    "build:renderer": "node scripts/build-renderer.mjs",
    "android:sync-python": "node scripts/sync-android-python.mjs",
    "apk": "node scripts/build-apk.mjs && node scripts/collect-release.mjs android",
    "release:collect": "node scripts/collect-release.mjs",
    "check": "node scripts/check-all.mjs",
    "precheck": "node scripts/ensure-cases.mjs --keep-mode",
    "preapk": "node scripts/setup-assets.mjs --check",
    "tauri": "tauri"
  },
  "dependencies": {
    "@glideapps/glide-data-grid": "^6.0.3",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slider": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-fs": "^2.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "papaparse": "^5.4.1",
    "plotly.js-dist-min": "^2.35.2",
    "pyodide": "^314.0.7",
    "radix-ui": "^1.7.0",
    "react": "^18.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^18.3.1",
    "roughjs": "^4.6.6",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
