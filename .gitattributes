# 统一 LF：源码、YAML、文档都用 LF（Windows 上的编辑器也按 LF 保存）
* text=auto eol=lf

# 图片 / 字体 / 压缩包：按二进制处理，避免行尾转换损坏文件
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.zip  binary
*.apk  binary
*.so   binary
*.dll  binary
*.exe  binary

# 生成物在 diff 里不显示（体积大、内容可重建）
app/src/gallery/cases.json  linguist-generated=true
app/package-lock.json       linguist-generated=true
